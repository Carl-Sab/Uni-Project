# Pydantic AI Gateway key used to reach Anthropic/OpenAI/Google models (see backend/app/llm.py)
PYDANTIC_AI_GATEWAY_API_KEY=

# Postgres connection string used by the backend (SQLAlchemy async, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/university_assistant

# Postgres credentials used by the postgres container itself
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=university_assistant

# Redis connection string used by the backend
REDIS_URL=redis://redis:6379/0

# Secret used to sign JWTs issued to students and admins
JWT_SECRET=change-me

# Admin panel login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
